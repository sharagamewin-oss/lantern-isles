rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Wishes = lanterns
    match /wishes/{wishId} {

      // Anyone can read wishes
      allow read: if true;

      // A logged-in guest can create ONE wish (document ID = their own user ID)
      allow create: if request.auth != null
        && wishId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['name', 'college', 'wishText', 'skills', 'createdAt', 'sparks', 'uid', 'hidden'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.college is string
        && request.resource.data.college.size() >= 1
        && request.resource.data.college.size() <= 60
        && request.resource.data.wishText is string
        && request.resource.data.wishText.size() >= 1
        && request.resource.data.wishText.size() <= 150
        && request.resource.data.skills is string
        && request.resource.data.skills.size() <= 100
        && request.resource.data.sparks == 0
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time;

      // SPARK: the only allowed change is sparks going up by exactly 1,
      // and only together with this person's own spark record.
      allow update: if request.auth != null
        && request.auth.uid != wishId
        && resource.data.hidden == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sparks'])
        && request.resource.data.sparks == resource.data.sparks + 1
        && !exists(/databases/$(database)/documents/wishes/$(wishId)/sparks/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/wishes/$(wishId)/sparks/$(request.auth.uid));

      // Nobody can delete a wish
      allow delete: if false;

      // One small record per person per lantern
      match /sparks/{sparkerId} {

        // You can only read your own spark record
        allow read: if request.auth != null && request.auth.uid == sparkerId;

        // You can create only YOUR record, never on your own lantern
        allow create: if request.auth != null
          && sparkerId == request.auth.uid
          && request.auth.uid != wishId
          && exists(/databases/$(database)/documents/wishes/$(wishId))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;

        // Records can never be changed or removed
        allow update, delete: if false;
      }
    }

    // Phase 4: rooms
    match /rooms/{roomId} {

      // Anyone can read rooms
      allow read: if true;

      // You can create ONLY your own room (the ID must be your guest ID),
      // and only if your wish exists (or is being created in the same action).
      // The name and college must match your wish.
      allow create: if request.auth != null
        && roomId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/wishes/$(roomId))
        && request.resource.data.keys().hasOnly(
             ['name', 'college', 'skills', 'projects', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['name', 'college', 'skills', 'projects', 'createdAt'])
        && request.resource.data.name == getAfter(/databases/$(database)/documents/wishes/$(roomId)).data.name
        && request.resource.data.college == getAfter(/databases/$(database)/documents/wishes/$(roomId)).data.college
        && request.resource.data.skills is string
        && request.resource.data.skills.size() <= 100
        && request.resource.data.projects is string
        && request.resource.data.projects.size() <= 300
        && request.resource.data.createdAt == request.time;

      // You can edit ONLY your own room, and ONLY skills and projects
      allow update: if request.auth != null
        && roomId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['skills', 'projects'])
        && request.resource.data.skills is string
        && request.resource.data.skills.size() <= 100
        && request.resource.data.projects is string
        && request.resource.data.projects.size() <= 300;

      // Nobody can delete a room
      allow delete: if false;
    }

    // NEW in Phase 5: art on Gallery Street
    // The picture is stored as a small text (a JPEG turned into text) in the imageUrl field.
    match /art/{artId} {

      // Anyone can read art
      allow read: if true;

      // You can create ONLY your own art (the ID must be your guest ID),
      // and only after you have lit a lantern.
      allow create: if request.auth != null
        && artId == request.auth.uid
        && exists(/databases/$(database)/documents/wishes/$(artId))
        && request.resource.data.keys().hasOnly(
             ['uid', 'title', 'imageUrl', 'flowers', 'createdAt', 'hidden'])
        && request.resource.data.keys().hasAll(
             ['uid', 'title', 'imageUrl', 'flowers', 'createdAt', 'hidden'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 120000
        && request.resource.data.imageUrl.matches('data:image/jpeg;base64,.*')
        && request.resource.data.flowers == 0
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null && (

        // (a) The OWNER can change the title and the picture, nothing else
        (artId == request.auth.uid
          && resource.data.hidden == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'imageUrl'])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 60
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.size() <= 120000
          && request.resource.data.imageUrl.matches('data:image/jpeg;base64,.*'))

        ||

        // (b) FLOWER: someone else can raise flowers by exactly 1,
        //     and only together with their own flower record.
        (request.auth.uid != artId
          && resource.data.hidden == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flowers'])
          && request.resource.data.flowers == resource.data.flowers + 1
          && !exists(/databases/$(database)/documents/art/$(artId)/flowers/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/art/$(artId)/flowers/$(request.auth.uid)))
      );

      // Nobody can delete art
      allow delete: if false;

      // One small record per person per picture
      match /flowers/{flowerId} {

        // You can only read your own flower record
        allow read: if request.auth != null && request.auth.uid == flowerId;

        // You can create only YOUR record, never on your own art
        allow create: if request.auth != null
          && flowerId == request.auth.uid
          && request.auth.uid != artId
          && exists(/databases/$(database)/documents/art/$(artId))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;

        // Records can never be changed or removed
        allow update, delete: if false;
      }
    }
  }
}
